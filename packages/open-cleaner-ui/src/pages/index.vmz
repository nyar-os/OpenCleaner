<template>
    <div data-open-cleaner="root" class="oc-root" :data-theme="themeValue">
        <header class="oc-header">
            <span class="oc-header__brand">Open Cleaner</span>
            <label class="oc-scope" for="oc-root">
                <span class="oc-scope__key">Scope</span>
                <input
                    id="oc-root"
                    class="oc-scope__input"
                    type="text"
                    autocomplete="off"
                    spellcheck="false"
                    :value="root"
                    :placeholder="rootPlaceholder"
                    :disabled="busy"
                    @input="onRootInput"
                    @keydown="onRootKey"
                />
            </label>
            <select
                class="oc-header__domain"
                :value="domain"
                aria-label="Cleanup domain"
                :disabled="busy"
                @change="onDomainChange"
            >
                <option v-for="item in domains" :key="item.id" :value="item.id">
                    {{ item.label }}
                </option>
            </select>
            <div class="oc-header__actions">
                <button type="button" class="oc-btn oc-btn--primary" :disabled="busy" @click="runScan">
                    {{ scanLabel }}
                </button>
            </div>
        </header>

        <div class="oc-main">
            <nav class="oc-domains" aria-label="Cleanup domains">
                <span class="oc-domains__title">Cleanup domains</span>
                <button
                    v-for="item in domains"
                    :key="item.id"
                    type="button"
                    :class="domainClass(item.id)"
                    :data-domain="item.id"
                    :aria-current="item.id === domain ? 'true' : 'false'"
                    :disabled="busy"
                    @click="pickDomain(item.id)"
                >
                    <span class="oc-domains__label">{{ item.label }}</span>
                    <span class="oc-domains__hint">{{ item.hint }}</span>
                </button>
            </nav>

            <section class="oc-work" aria-label="Candidates">
                <div class="oc-work__bar">
                    <div class="oc-work__heading">
                        <h1 class="oc-work__title">
                            {{ domainTitle }}
                        </h1>
                        <span class="oc-work__meta">{{ domainMeta }}</span>
                    </div>
                    <input
                        v-if="filterVisible"
                        class="oc-filter"
                        type="search"
                        :value="filter"
                        placeholder="Filter by path"
                        aria-label="Filter candidates"
                        @input="onFilterInput"
                    />
                    <button
                        type="button"
                        class="oc-btn"
                        :aria-expanded="inspectorAttr"
                        data-role="inspector-toggle"
                        @click="toggleInspector"
                    >
                        {{ inspectorLabel }}
                    </button>
                </div>

                <div v-if="busy" class="oc-state">
                    <span class="oc-spinner" aria-hidden="true"></span>
                    <p class="oc-state__text">
                        {{ statusText }}
                    </p>
                </div>

                <div v-else-if="errorText" class="oc-state oc-state--error" role="alert">
                    <p class="oc-state__title">
                        {{ errorTitle }}
                    </p>
                    <p class="oc-state__text">
                        {{ errorText }}
                    </p>
                    <button type="button" class="oc-btn" @click="runScan">
                        Retry
                    </button>
                </div>

                <div v-else-if="planOpen" class="oc-plan">
                    <div class="oc-plan__head">
                        <h2 class="oc-plan__title">
                            {{ planTitle }}
                        </h2>
                        <p class="oc-plan__meta">
                            {{ planMeta }}
                        </p>
                    </div>
                    <ul class="oc-plan__list">
                        <li v-for="row in planRows" :key="row.id" class="oc-plan__row" :data-tone="row.tone">
                            <span class="oc-plan__key">{{ row.key }}</span>
                            <span class="oc-plan__value">{{ row.value }}</span>
                        </li>
                    </ul>
                    <p v-if="planWarning" class="oc-plan__warning">
                        {{ planWarning }}
                    </p>
                    <div class="oc-plan__actions">
                        <button type="button" class="oc-btn" @click="closePlan">
                            Back to candidates
                        </button>
                    </div>
                </div>

                <div v-else-if="resultsOpen" class="oc-plan">
                    <div class="oc-plan__head">
                        <h2 class="oc-plan__title">
                            {{ resultTitle }}
                        </h2>
                        <p class="oc-plan__meta">
                            {{ resultMeta }}
                        </p>
                    </div>
                    <ul class="oc-plan__list">
                        <li v-for="row in resultRows" :key="row.id" class="oc-plan__row" :data-tone="row.tone">
                            <span class="oc-plan__key">{{ row.key }}</span>
                            <span class="oc-plan__value">{{ row.value }}</span>
                        </li>
                    </ul>
                    <div class="oc-plan__actions">
                        <button type="button" class="oc-btn" @click="closeResults">
                            Back to candidates
                        </button>
                    </div>
                </div>

                <DiskBoard
                    v-else-if="domain === 'disk'"
                    :rows="boardRows"
                    :title="boardTitle"
                    :meta="boardMeta"
                    :note="boardNote"
                    :totalBytes="boardTotal"
                    :selectedId="focusedId"
                    :onPick="focusNode"
                />

                <div v-else-if="rows.length" class="oc-table">
                    <div class="oc-table__head" role="row">
                        <span class="oc-table__cell oc-table__cell--check" aria-hidden="true"></span>
                        <button type="button" class="oc-table__cell oc-table__cell--name" @click="sortBy('name')">
                            Name
                        </button>
                        <span class="oc-table__cell oc-table__cell--path">Path</span>
                        <button type="button" class="oc-table__cell oc-table__cell--bytes" @click="sortBy('bytes')">
                            Size
                        </button>
                        <span class="oc-table__cell oc-table__cell--reason">Reason</span>
                        <span class="oc-table__cell oc-table__cell--action">Action</span>
                    </div>
                    <div class="oc-table__body" role="table">
                        <div
                            v-for="row in rows"
                            :key="row.id"
                            class="oc-table__row"
                            :data-tone="row.tone"
                            :data-selected="row.id === focusedId ? 'true' : 'false'"
                            role="row"
                            @click="activateRow(row.id)"
                        >
                            <span class="oc-table__cell oc-table__cell--check">
                                <button
                                    v-if="row.selectable"
                                    type="button"
                                    class="oc-check"
                                    :data-on="row.selected ? 'true' : 'false'"
                                    :aria-pressed="row.selected ? 'true' : 'false'"
                                    :aria-label="'Select ' + row.name"
                                    @click="toggleRow(row.id)"
                                >
                                </button>
                                <span v-else class="oc-check oc-check--locked" aria-hidden="true">·</span>
                            </span>
                            <span class="oc-table__cell oc-table__cell--name" :title="row.name">{{ row.name }}</span>
                            <span class="oc-table__cell oc-table__cell--path" :title="row.path">{{ row.path }}</span>
                            <span class="oc-table__cell oc-table__cell--bytes">{{ row.sizeText }}</span>
                            <span class="oc-table__cell oc-table__cell--reason" :title="row.reasonText">{{ row.reasonText }}</span>
                            <span class="oc-table__cell oc-table__cell--action">{{ row.actionText }}</span>
                        </div>
                    </div>
                </div>

                <div v-else class="oc-state">
                    <p class="oc-state__title">
                        {{ emptyTitle }}
                    </p>
                    <p class="oc-state__text">
                        {{ emptyText }}
                    </p>
                </div>
            </section>

            <aside v-if="inspectorOpen" class="oc-inspector" aria-label="Inspector">
                <div class="oc-inspector__head">
                    <span class="oc-inspector__title">Inspector</span>
                </div>
                <div v-if="focusedPath" class="oc-inspector__body">
                    <div class="oc-field">
                        <span class="oc-field__key">Path</span>
                        <span class="oc-field__value oc-field__value--mono" :title="focusedPath">{{ focusedPath }}</span>
                    </div>
                    <div class="oc-field">
                        <span class="oc-field__key">Kind</span>
                        <span class="oc-field__value">{{ focusedKind }}</span>
                    </div>
                    <div class="oc-field">
                        <span class="oc-field__key">Size</span>
                        <span class="oc-field__value oc-field__value--mono">{{ focusedSize }}</span>
                    </div>
                    <div class="oc-field">
                        <span class="oc-field__key">Share</span>
                        <span class="oc-field__value oc-field__value--mono">{{ focusedShare }}</span>
                    </div>
                    <div class="oc-field">
                        <span class="oc-field__key">Reason</span>
                        <span class="oc-field__value">{{ focusedReason }}</span>
                    </div>
                    <div class="oc-field">
                        <span class="oc-field__key">Action</span>
                        <span class="oc-field__value">{{ focusedAction }}</span>
                    </div>
                    <div class="oc-field">
                        <span class="oc-field__key">Safety</span>
                        <span class="oc-field__value">{{ focusedSafety }}</span>
                    </div>
                    <div class="oc-field">
                        <span class="oc-field__key">Evidence</span>
                        <span class="oc-field__value">{{ focusedEvidence }}</span>
                    </div>
                    <p v-if="focusedNote" class="oc-inspector__note">
                        {{ focusedNote }}
                    </p>
                </div>
                <p v-else class="oc-inspector__empty">
                    {{ inspectorEmpty }}
                </p>
            </aside>
        </div>

        <footer class="oc-footer">
            <div class="oc-summary">
                <div class="oc-summary__facts">
                    <span class="oc-summary__count">{{ selectionCountText }}</span>
                    <span class="oc-summary__bytes">{{ selectionBytesText }}</span>
                    <span class="oc-summary__mode">{{ selectionModeText }}</span>
                </div>
                <div class="oc-summary__actions">
                    <button type="button" class="oc-btn" :disabled="clearDisabled" @click="clearSelection">
                        Clear
                    </button>
                    <button type="button" class="oc-btn" :disabled="reviewDisabled" @click="openPlan">
                        Review plan
                    </button>
                    <button type="button" class="oc-btn oc-btn--primary" :disabled="executeDisabled" @click="execute">
                        {{ executeLabel }}
                    </button>
                </div>
            </div>
            <div class="oc-status">
                <span class="oc-status__text">{{ statusBarText }}</span>
                <span class="oc-status__right">
                    <span class="oc-status__time">{{ lastScanText }}</span>
                    <button type="button" class="oc-status__theme" @click="cycleTheme">
                        {{ themeLabel }}
                    </button>
                </span>
            </div>
        </footer>
    </div>
</template>

<style>
html,
body {
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: var(--vmz-surface-page);
}

.oc-root {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--vmz-surface-page);
    color: var(--vmz-text-ink);
    font-family: var(--vmz-font-sans);
    font-size: 13px;
    line-height: 1.4;
}

.oc-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: none;
    height: 40px;
    padding: 0 0.75rem;
    border-bottom: 1px solid var(--vmz-line-default);
    background: var(--vmz-surface-paper);
}

.oc-header__brand {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--vmz-text-ink);
    white-space: nowrap;
}

.oc-scope {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
}

.oc-scope__key {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--vmz-text-tertiary);
}

.oc-scope__input {
    flex: 1;
    min-width: 0;
    height: 26px;
    padding: 0 0.5rem;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-sm);
    background: var(--vmz-surface-mist);
    color: var(--vmz-text-ink);
    font-family: var(--vmz-font-mono);
    font-size: 0.75rem;
}

.oc-scope__input:focus {
    outline: 2px solid var(--vmz-focus-ring);
    outline-offset: -1px;
    background: var(--vmz-surface-paper);
}

.oc-header__domain {
    display: none;
    height: 26px;
    padding: 0 0.375rem;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-sm);
    background: var(--vmz-surface-paper);
    color: var(--vmz-text-ink);
    font-family: var(--vmz-font-sans);
    font-size: 0.75rem;
}

.oc-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
}

.oc-main {
    position: relative;
    display: flex;
    flex: 1;
    min-height: 0;
}

.oc-domains {
    display: flex;
    flex-direction: column;
    gap: 1px;
    flex: none;
    width: 200px;
    padding: 0.375rem;
    border-right: 1px solid var(--vmz-line-default);
    background: var(--vmz-surface-mist);
    overflow: auto;
}

.oc-domains__title {
    padding: 0.375rem 0.5rem;
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--vmz-text-muted);
}

.oc-domains button {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
    padding: 0.375rem 0.5rem;
    border: 0;
    border-left: 2px solid transparent;
    border-radius: var(--vmz-radius-sm);
    background: transparent;
    color: var(--vmz-text-ink);
    font-family: inherit;
    text-align: left;
    cursor: pointer;
}

.oc-domains button:hover:not(:disabled) {
    background: var(--vmz-action-secondary-hover);
}

.oc-domains button:disabled {
    cursor: default;
    opacity: 0.55;
}

.oc-domains button:focus-visible {
    outline: 2px solid var(--vmz-focus-ring);
    outline-offset: -2px;
}

.oc-domains button[aria-current="true"] {
    border-left-color: var(--vmz-action-primary-background);
    background: var(--vmz-surface-paper);
}

.oc-domains__label {
    font-size: 0.75rem;
    font-weight: 500;
}

.oc-domains__hint {
    font-size: 0.6875rem;
    color: var(--vmz-text-tertiary);
}

.oc-work {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: var(--vmz-surface-paper);
}

.oc-work > [data-vmz="DiskBoard"] {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
}

.oc-work > [data-vmz="DiskBoard"] > .oc-board {
    flex: 1;
    min-height: 0;
}

.oc-work__bar {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex: none;
    min-height: 38px;
    padding: 0 0.75rem;
    border-bottom: 1px solid var(--vmz-line-default);
}

.oc-work__heading {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
}

.oc-work__title {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
}

.oc-work__meta {
    font-size: 0.6875rem;
    color: var(--vmz-text-tertiary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.oc-filter {
    flex: 1;
    min-width: 6rem;
    max-width: 18rem;
    height: 26px;
    padding: 0 0.5rem;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-sm);
    background: var(--vmz-surface-mist);
    color: var(--vmz-text-ink);
    font-family: var(--vmz-font-sans);
    font-size: 0.75rem;
}

.oc-filter:focus {
    outline: 2px solid var(--vmz-focus-ring);
    outline-offset: -1px;
    background: var(--vmz-surface-paper);
}

.oc-btn {
    flex: none;
    height: 26px;
    padding: 0 0.625rem;
    border: 1px solid var(--vmz-line-default);
    border-radius: var(--vmz-radius-sm);
    background: var(--vmz-action-secondary-background);
    color: var(--vmz-text-ink);
    font-family: var(--vmz-font-sans);
    font-size: 0.75rem;
    cursor: pointer;
}

.oc-btn:hover:not(:disabled) {
    background: var(--vmz-action-secondary-hover);
}

.oc-btn:focus-visible {
    outline: 2px solid var(--vmz-focus-ring);
    outline-offset: 1px;
}

.oc-btn:disabled {
    cursor: default;
    opacity: 0.5;
}

.oc-btn--primary {
    border-color: var(--vmz-action-primary-background);
    background: var(--vmz-action-primary-background);
    color: var(--vmz-action-primary-foreground);
}

.oc-btn--primary:hover:not(:disabled) {
    background: var(--vmz-action-primary-hover);
}

.oc-work__bar .oc-btn {
    margin-left: auto;
}

.oc-state {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.5rem;
    flex: 1;
    min-height: 0;
    padding: 2rem;
    overflow: auto;
}

.oc-state__title {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
}

.oc-state__text {
    margin: 0;
    max-width: 46rem;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--vmz-text-tertiary);
}

.oc-state--error {
    border-left: 2px solid var(--vmz-status-danger-accent);
    background: var(--vmz-status-danger-background);
}

.oc-state--error .oc-state__title {
    color: var(--vmz-status-danger-foreground);
}

.oc-spinner {
    width: 14px;
    height: 14px;
    border: 2px solid var(--vmz-line-default);
    border-top-color: var(--vmz-action-primary-background);
    border-radius: 50%;
    animation: oc-spin 0.9s linear infinite;
}

@keyframes oc-spin {
    to {
        transform: rotate(360deg);
    }
}

.oc-table {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
}

.oc-table__head,
.oc-table__row {
    display: grid;
    grid-template-columns: 22px minmax(8rem, 1fr) minmax(10rem, 2fr) 5.5rem minmax(9rem, 1.2fr) 7.5rem;
    gap: 0.5rem;
    align-items: center;
    padding: 0 0.75rem;
}

.oc-table__head {
    flex: none;
    height: 28px;
    border-bottom: 1px solid var(--vmz-line-default);
    background: var(--vmz-surface-mist);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--vmz-text-tertiary);
}

.oc-table__head .oc-table__cell {
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: default;
}

.oc-table__head button.oc-table__cell {
    cursor: pointer;
}

.oc-table__head button.oc-table__cell:hover {
    color: var(--vmz-text-ink);
}

.oc-table__body {
    flex: 1;
    min-height: 0;
    overflow: auto;
}

.oc-table__row {
    min-height: 30px;
    border-bottom: 1px solid var(--vmz-line-subtle);
    cursor: pointer;
}

.oc-table__row:hover {
    background: var(--vmz-action-secondary-hover);
}

.oc-table__row[data-selected="true"] {
    background: var(--vmz-action-primary-soft);
    border-left: 2px solid var(--vmz-action-primary-background);
    padding-left: calc(0.75rem - 2px);
}

.oc-table__row[data-tone="skipped"] {
    color: var(--vmz-text-tertiary);
}

.oc-table__cell {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.75rem;
}

.oc-table__cell--path,
.oc-table__cell--bytes {
    font-family: var(--vmz-font-mono);
    font-size: 0.6875rem;
    color: var(--vmz-text-tertiary);
}

.oc-table__cell--bytes {
    text-align: right;
    font-variant-numeric: tabular-nums;
}

.oc-table__cell--reason,
.oc-table__cell--action {
    color: var(--vmz-text-tertiary);
}

.oc-table__cell--check {
    display: flex;
    align-items: center;
}

.oc-check {
    width: 14px;
    height: 14px;
    padding: 0;
    border: 1px solid var(--vmz-line-strong);
    border-radius: 3px;
    background: var(--vmz-surface-paper);
    cursor: pointer;
}

.oc-check[data-on="true"] {
    border-color: var(--vmz-action-primary-background);
    background: var(--vmz-action-primary-background);
}

.oc-check[data-on="true"]::after {
    content: "";
    display: block;
    width: 6px;
    height: 3px;
    margin: 2px 0 0 3px;
    border-left: 2px solid var(--vmz-action-primary-foreground);
    border-bottom: 2px solid var(--vmz-action-primary-foreground);
    transform: rotate(-45deg);
}

.oc-check--locked {
    border: 0;
    cursor: default;
    color: var(--vmz-text-muted);
    text-align: center;
}

.oc-plan {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    padding: 0.75rem;
    gap: 0.625rem;
}

.oc-plan__head {
    flex: none;
}

.oc-plan__title {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
}

.oc-plan__meta {
    margin: 0.25rem 0 0;
    font-size: 0.6875rem;
    color: var(--vmz-text-tertiary);
}

.oc-plan__list {
    flex: 1;
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow: auto;
    list-style: none;
    border-top: 1px solid var(--vmz-line-subtle);
}

.oc-plan__row {
    display: grid;
    grid-template-columns: minmax(10rem, 1.4fr) minmax(10rem, 2fr);
    gap: 0.75rem;
    padding: 0.375rem 0;
    border-bottom: 1px solid var(--vmz-line-subtle);
    font-size: 0.75rem;
}

.oc-plan__row[data-tone="skipped"] {
    color: var(--vmz-text-tertiary);
}

.oc-plan__key {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--vmz-font-mono);
    font-size: 0.6875rem;
}

.oc-plan__value {
    color: var(--vmz-text-tertiary);
}

.oc-plan__warning {
    flex: none;
    margin: 0;
    padding: 0.375rem 0.5rem;
    border-left: 2px solid var(--vmz-status-warning-accent);
    background: var(--vmz-status-warning-background);
    color: var(--vmz-status-warning-foreground);
    font-size: 0.6875rem;
    line-height: 1.5;
}

.oc-plan__actions {
    display: flex;
    justify-content: flex-end;
    flex: none;
}

.oc-inspector {
    display: flex;
    flex-direction: column;
    flex: none;
    width: 300px;
    border-left: 1px solid var(--vmz-line-default);
    background: var(--vmz-surface-mist);
    overflow: auto;
}

.oc-inspector__head {
    flex: none;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--vmz-line-subtle);
}

.oc-inspector__title {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--vmz-text-muted);
}

.oc-inspector__body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 0.625rem 0.75rem;
}

.oc-field {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
}

.oc-field__key {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--vmz-text-muted);
}

.oc-field__value {
    font-size: 0.75rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
}

.oc-field__value--mono {
    font-family: var(--vmz-font-mono);
    font-size: 0.6875rem;
    color: var(--vmz-text-tertiary);
}

.oc-inspector__note {
    margin: 0;
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--vmz-text-muted);
}

.oc-inspector__empty {
    margin: 0;
    padding: 0.75rem;
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--vmz-text-muted);
}

.oc-footer {
    flex: none;
    border-top: 1px solid var(--vmz-line-default);
    background: var(--vmz-surface-paper);
}

.oc-summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 36px;
    padding: 0 0.75rem;
    border-bottom: 1px solid var(--vmz-line-subtle);
}

.oc-summary__facts {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-size: 0.75rem;
}

.oc-summary__count {
    font-weight: 600;
}

.oc-summary__bytes {
    font-family: var(--vmz-font-mono);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--vmz-text-ink);
}

.oc-summary__mode {
    font-size: 0.6875rem;
    color: var(--vmz-text-tertiary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.oc-summary__actions {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-left: auto;
}

.oc-status {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 26px;
    padding: 0 0.75rem;
    font-size: 0.6875rem;
    color: var(--vmz-text-tertiary);
}

.oc-status__text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.oc-status__right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
    font-variant-numeric: tabular-nums;
}

.oc-status__theme {
    border: 0;
    background: transparent;
    color: var(--vmz-text-tertiary);
    font: inherit;
    cursor: pointer;
}

.oc-status__theme:hover {
    color: var(--vmz-text-ink);
}

@media (max-width: 1020px) {
    .oc-domains {
        display: none;
    }

    .oc-header__domain {
        display: block;
    }
}

@media (max-width: 940px) {
    .oc-inspector {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        z-index: 3;
        width: 280px;
        border-left: 1px solid var(--vmz-line-strong);
        box-shadow: var(--vmz-shadow-popup);
    }

    .oc-table__head,
    .oc-table__row {
        grid-template-columns: 22px minmax(7rem, 1fr) minmax(8rem, 1.6fr) 4.75rem 6.5rem;
    }

    .oc-table__cell--action {
        display: none;
    }
}
</style>

<script client>
const DOMAINS = [
    { id: "disk", label: "Disk usage", hint: "Largest files under a root" },
    { id: "temp", label: "Temp files", hint: "Older than the cutoff" },
    { id: "dev", label: "Dev artifacts", hint: "Project build caches" },
    { id: "buildRoots", label: "Build roots", hint: "Declared in the config" },
    { id: "registry", label: "Registry residue", hint: "Orphaned keys" },
    { id: "envPath", label: "PATH entries", hint: "Empty, missing or duplicate" },
    { id: "software", label: "Software residue", hint: "Uninstalled leftovers" },
];

const DOMAIN_TITLES = {
    disk: "Disk usage",
    temp: "Temp files",
    dev: "Dev artifacts",
    buildRoots: "Build roots",
    registry: "Registry residue",
    envPath: "PATH entries",
    software: "Software residue",
};

function baseName(value) {
    const text = String(value || "").replace(/[\\/]+$/, "");
    const cut = Math.max(text.lastIndexOf("\\"), text.lastIndexOf("/"));
    return cut >= 0 ? text.slice(cut + 1) || text : text;
}

function formatBytes(bytes) {
    const value = Number(bytes) || 0;
    if (value < 1024) return value + " B";
    const units = ["KB", "MB", "GB", "TB"];
    let scaled = value / 1024;
    let index = 0;
    while (scaled >= 1024 && index < units.length - 1) {
        scaled /= 1024;
        index += 1;
    }
    return (scaled >= 100 ? scaled.toFixed(0) : scaled.toFixed(1)) + " " + units[index];
}

function formatCount(value, noun) {
    const count = Number(value) || 0;
    return count + " " + noun + (count === 1 ? "" : "s");
}

export default class OpenCleanerPage {
    public domains = [...DOMAINS];
    /** Domain titles double as the workbench heading; kept as a field so the template never reads module scope. */
    public domainTitles = DOMAIN_TITLES;
    public domain = "disk";
    public busy = false;
    public errorText = "";
    public errorTitle = "Scan failed";
    public statusText = "";
    public root = "";
    public rootPlaceholder = "Root path (empty = host default)";
    public filter = "";
    public filterVisible = false;
    public rows = [];
    public raw = [];
    public sortKey = "bytes";
    public sortDir = "desc";
    public planOpen = false;
    public planTitle = "";
    public planMeta = "";
    public planRows = [];
    public planWarning = "";
    public resultsOpen = false;
    public resultTitle = "";
    public resultMeta = "";
    public resultRows = [];
    public boardRows = [];
    public boardTitle = "Disk usage";
    public boardMeta = "";
    public boardNote = "";
    public boardTotal = 0;
    public focusedId = "";
    public focusedPath = "";
    public focusedKind = "";
    public focusedSize = "";
    public focusedShare = "";
    public focusedReason = "";
    public focusedAction = "";
    public focusedSafety = "";
    public focusedEvidence = "";
    public focusedNote = "";
    public inspectorOpen = true;
    public inspectorLabel = "Hide inspector";
    public inspectorAttr = "true";
    public inspectorEmpty = "Select a candidate to see why it was flagged, what the app can do with it and how risky that is.";
    public selectedCount = 0;
    public selectedBytes = 0;
    public selectionCountText = "No selection";
    public selectionBytesText = "";
    public selectionModeText = "";
    public statusBarText = "";
    public lastScanText = "";
    public scanLabel = "Scan";
    public executeLabel = "Execute";
    public reviewDisabled = true;
    public executeDisabled = true;
    public clearDisabled = true;
    public domainTitle = "Disk usage";
    public domainMeta = "";
    public emptyTitle = "Nothing scanned yet";
    public emptyText = "Run a scan to load real candidates from this machine.";
    public themeLabel = "Theme: Auto";
    public themeValue = "";
    public host = null;
    public activeId = "";
    public seq = 0;
    public mode = "trash";
    public tempCutoffMs = 0;
    public tempRoot = "";
    public tempOlderThanDays = 7;
    public buildConfig = "";
    public scanStartedMs = 0;
    /** Whole-plan totals for temp scans; per-file selection is not offered there. */
    public planTempFiles = 0;
    public planTempBytes = 0;

    onMount() {
        const viewport = typeof window !== "undefined" ? window.innerWidth : 1280;
        this.inspectorOpen = viewport >= 940;
        this.syncInspector();
        if (!this.installBridge()) return;
        this.runScan();
    }

    installBridge() {
        const host =
            typeof chrome !== "undefined" && chrome && chrome.webview ? chrome.webview : null;
        if (!host) {
            this.busy = false;
            this.errorText =
                "Native host bridge is unavailable. Open this workbench through `open-cleaner gui`.";
            this.statusBarText = "Host bridge missing";
            return false;
        }
        this.host = host;
        host.addEventListener("message", (event) => this.onHostMessage(event && event.data));
        return true;
    }

    post(type, extra) {
        if (!this.host) return;
        this.seq += 1;
        const id = "oc-" + this.seq;
        this.activeId = id;
        const message = Object.assign({ type, id }, extra || {});
        this.host.postMessage(JSON.stringify(message));
    }

    onHostMessage(raw) {
        if (!raw) return;
        let message = raw;
        if (typeof raw === "string") {
            try {
                message = JSON.parse(raw);
            } catch {
                return;
            }
        }
        if (!message || !message.type) return;
        if (message.id !== this.activeId) return;
        if (message.type === "scanResult") return this.applyScan(message.report);
        if (message.type === "devPlanResult") return this.applyDevPlan(message.report);
        if (message.type === "devCleanResult") return this.applyDevClean(message.report);
        if (message.type === "tempPlanResult") return this.applyTempPlan(message.report);
        if (message.type === "tempCleanResult") return this.applyTempClean(message.report);
        if (message.type === "buildRootPlanResult") return this.applyBuildRootPlan(message.report);
        if (message.type === "buildRootCleanResult") return this.applyBuildRootClean(message.report);
        if (message.type === "registryResidueResult") return this.applyRegistry(message.report);
        if (message.type === "envPathScanResult") return this.applyEnvPath(message.report);
        if (message.type === "softwareResidueResult") return this.applySoftware(message.report);
        if (String(message.type).indexOf("Error") >= 0) return this.fail(message.message);
    }

    pickDomain(id) {
        if (this.busy || !id || id === this.domain) return;
        this.domain = id;
        this.resetDomainView();
        this.runScan();
    }

    onDomainChange(event) {
        const next = event && event.target ? event.target.value : "";
        this.pickDomain(next);
    }

    onRootInput(event) {
        this.root = event && event.target ? event.target.value : "";
    }

    onRootKey(event) {
        if (event && event.key === "Enter") this.runScan();
    }

    onFilterInput(event) {
        this.filter = event && event.target ? event.target.value : "";
        this.refreshRows();
    }

    toggleInspector() {
        this.inspectorOpen = !this.inspectorOpen;
        this.syncInspector();
    }

    syncInspector() {
        this.inspectorLabel = this.inspectorOpen ? "Hide inspector" : "Show inspector";
        this.inspectorAttr = this.inspectorOpen ? "true" : "false";
    }

    cycleTheme() {
        if (this.themeValue === "") {
            this.themeValue = "light";
            this.themeLabel = "Theme: Light";
            return;
        }
        if (this.themeValue === "light") {
            this.themeValue = "dark";
            this.themeLabel = "Theme: Dark";
            return;
        }
        this.themeValue = "";
        this.themeLabel = "Theme: Auto";
    }

    domainClass(id) {
        return id === this.domain ? "oc-domains__item is-active" : "oc-domains__item";
    }

    resetDomainView() {
        this.raw = [];
        this.rows = [];
        this.planTempFiles = 0;
        this.planTempBytes = 0;
        this.mode = "trash";
        this.candidatesReset();
        this.boardRows = [];
        this.boardTitle = this.domainTitles[this.domain] || "";
        this.boardMeta = "";
        this.boardNote = "";
        this.boardTotal = 0;
        this.focusedId = "";
        this.clearFocused();
        this.planOpen = false;
        this.resultsOpen = false;
        this.errorText = "";
        this.domainTitle = this.domainTitles[this.domain] || "";
        this.domainMeta = "";
        this.filter = "";
        this.filterVisible = this.domain !== "disk";
        this.emptyTitle = "Nothing scanned yet";
        this.emptyText = "Run a scan to load real candidates from this machine.";
        this.recalcSelection();
    }

    runScan() {
        if (this.busy) return;
        if (!this.host) {
            this.errorText = "Native host bridge is unavailable.";
            return;
        }
        this.busy = true;
        this.errorText = "";
        this.planOpen = false;
        this.resultsOpen = false;
        this.raw = [];
        this.rows = [];
        this.planTempFiles = 0;
        this.planTempBytes = 0;
        this.mode = "trash";
        this.candidatesReset();
        this.boardRows = [];
        this.focusedId = "";
        this.clearFocused();
        this.scanStartedMs = Date.now();
        this.statusText = (this.domainTitles[this.domain] || "Scan") + " scan in progress…";
        this.statusBarText = "Scanning…";
        this.lastScanText = "";
        this.recalcSelection();

        if (this.domain === "disk") {
            this.post("scan", { root: this.root ? this.root : null });
            return;
        }
        if (this.domain === "temp") {
            this.post("tempPlan", {
                options: {
                    root: this.root ? this.root : null,
                    olderThanDays: this.tempOlderThanDays,
                    sampleLimit: 40,
                },
            });
            return;
        }
        if (this.domain === "dev") {
            this.post("devPlan", { options: this.devOptions(), mode: this.mode });
            return;
        }
        if (this.domain === "buildRoots") {
            this.post("buildRootPlan", { options: this.root ? { config: this.root } : {} });
            return;
        }
        if (this.domain === "registry") {
            this.post("registryResidue", { options: { limit: 60 } });
            return;
        }
        if (this.domain === "envPath") {
            this.post("envPathScan", { options: {} });
            return;
        }
        if (this.domain === "software") {
            this.post("softwareResidue", { options: { limit: 60 } });
        }
    }

    devOptions() {
        return {
            roots: this.root ? [this.root] : [],
            includeGlobal: false,
            limit: 200,
        };
    }

    fail(message) {
        this.busy = false;
        this.errorText = String(message || "The host rejected the request.");
        this.statusText = "Scan failed";
        this.statusBarText = "Scan failed";
        this.emptyTitle = "Scan failed";
        this.emptyText = "Fix the condition above and retry.";
        this.recalcSelection();
    }

    settleNote() {
        const elapsed = Date.now() - this.scanStartedMs;
        this.lastScanText = "Scan " + elapsed + " ms";
        this.busy = false;
    }

    candidatesReset() {
        this.selectedCount = 0;
        this.selectedBytes = 0;
    }

    applyScan(report) {
        this.settleNote();
        const entries = report.entries || [];
        const shown = entries.reduce((total, entry) => total + (Number(entry.bytes) || 0), 0);
        this.boardRows = this.buildBoard(report.root, entries);
        this.boardTitle = baseName(report.root) || report.root;
        this.boardTotal = shown;
        this.boardMeta =
            "Scanned " + formatBytes(report.totalBytes) +
            " · listing the " + entries.length + " largest files (" + formatBytes(shown) + ")";
        this.boardNote =
            "Bars compare the listed files, not every scanned byte. Drilling into a directory arrives with the treemap package.";
        this.domainTitle = this.domainTitles.disk;
        this.domainMeta = formatCount(entries.length, "file") + " listed";
        this.statusText = "";
        this.statusBarText = "Disk scan ready · " + formatCount(entries.length, "file") + " listed";
        this.emptyTitle = "No files above the scan threshold";
        this.emptyText = "This root produced no file entries. Choose another scope and scan again.";
        const rootRow = this.boardRows.length ? this.boardRows[0] : null;
        if (rootRow) this.focusNode(rootRow.id);
        this.recalcSelection();
    }

    buildBoard(root, entries) {
        const rootPath = String(root || "");
        const rootId = rootPath || "root";
        const rootRow = {
            id: rootId,
            parent: null,
            path: rootPath,
            label: baseName(rootPath) || rootPath,
            depth: 0,
            kind: "dir",
            bytes: 0,
        };
        const nodes = {};
        nodes[rootId] = rootRow;
        const order = [rootId];
        const lowerRoot = rootPath.replace(/[\\/]+$/, "").toLowerCase();

        for (const entry of entries) {
            const pathText = String(entry.path || "");
            let rest = pathText;
            if (lowerRoot && pathText.toLowerCase().indexOf(lowerRoot) === 0) {
                rest = pathText.slice(lowerRoot.length).replace(/^[\\/]+/, "");
            }
            const segments = rest.split(/[\\/]+/).filter(Boolean);
            if (!segments.length) continue;
            let cursor = rootId;
            for (let index = 0; index < segments.length; index += 1) {
                const isFile = index === segments.length - 1;
                const id = cursor + "\\" + segments[index];
                let node = nodes[id];
                if (!node) {
                    node = {
                        id,
                        parent: cursor,
                        path: (rootPath ? rootPath.replace(/[\\/]+$/, "") + "\\" : "") + segments.slice(0, index + 1).join("\\"),
                        label: segments[index],
                        depth: Math.min(index + 1, 4),
                        kind: isFile ? String(entry.kind || "file") : "dir",
                        bytes: 0,
                    };
                    nodes[id] = node;
                    order.push(id);
                }
                node.bytes += Number(entry.bytes) || 0;
                cursor = id;
            }
        }

        rootRow.bytes = entries.reduce((sum, entry) => sum + (Number(entry.bytes) || 0), 0);

        const children = {};
        for (const id of order) {
            const node = nodes[id];
            if (node.parent === null) continue;
            if (!children[node.parent]) children[node.parent] = [];
            children[node.parent].push(node);
        }
        const flat = [];
        const walk = (id) => {
            const node = nodes[id];
            flat.push(node);
            const kids = children[id] || [];
            kids.sort((left, right) => right.bytes - left.bytes);
            for (const kid of kids) walk(kid.id);
        };
        walk(rootId);
        return flat.slice(0, 260);
    }

    focusNode(id) {
        this.focusedId = id;
        let row = null;
        for (const item of this.boardRows) {
            if (item.id === id) {
                row = item;
                break;
            }
        }
        if (!row) return;
        const share = this.boardTotal > 0 ? (row.bytes / this.boardTotal) * 100 : 0;
        this.focusedPath = row.path;
        this.focusedKind = row.kind === "dir" ? "Directory (rolled up)" : row.kind;
        this.focusedSize = formatBytes(row.bytes);
        this.focusedShare = share.toFixed(1) + "% of the listed files";
        this.focusedReason = "Measured by the disk scan and classified as " + row.kind + ".";
        this.focusedAction = "Read-only: the disk scan never deletes anything.";
        this.focusedSafety = "No destructive action is available here.";
        this.focusedEvidence = "Listed among the largest files under " + this.boardTitle + ".";
        this.focusedNote = "";
    }

    applyDevPlan(report) {
        this.settleNote();
        if (!report.modeSupported && report.mode === "trash") {
            this.mode = "permanent";
            this.statusText = "Recycle bin unavailable; re-planning for permanent deletion…";
            this.post("devPlan", { options: this.devOptions(), mode: "permanent" });
            return;
        }
        this.mode = report.mode || this.mode;
        const items = report.items || [];
        this.acceptCandidates(
            items.map((item) => {
                const artifact = item.artifact || {};
                const removable = !!item.removable;
                return {
                    id: String(artifact.path || ""),
                    name: baseName(artifact.path),
                    path: String(artifact.path || ""),
                    sizeText: formatBytes(artifact.bytes),
                    bytes: Number(artifact.bytes) || 0,
                    reasonText: [artifact.ecosystem, artifact.rule].filter(Boolean).join(" · "),
                    actionText: removable ? (this.mode === "trash" ? "Recycle bin" : "Permanent delete") : "Keep",
                    selectable: removable,
                    selected: false,
                    tone: removable ? "removable" : "skipped",
                    baseline: artifact.baseline || null,
                    kind: String(artifact.rule || "artifact"),
                    safety: String(artifact.risk || ""),
                    evidence: "Level " + artifact.level + " · " + String(artifact.anchor || ""),
                    note: (artifact.warnings || []).join(" "),
                    skipReason: String(item.skipReason || ""),
                };
            }),
        );
        this.domainMeta = formatCount(items.length, "artifact");
        this.statusBarText =
            "Dev scan ready · " + formatCount(items.length, "artifact") +
            " · " + formatBytes(report.removableBytes) + " removable";
        this.emptyTitle = "No developer artifacts";
        this.emptyText = "No project build caches matched under this scope.";
    }

    applyTempPlan(report) {
        this.settleNote();
        this.tempCutoffMs = report.cutoffUnixMs;
        this.tempRoot = report.root;
        this.tempOlderThanDays = report.olderThanDays;
        const samples = report.samples || [];
        this.acceptCandidates(
            samples.map((sample) => ({
                id: String(sample.path || ""),
                name: baseName(sample.path),
                path: String(sample.path || ""),
                sizeText: formatBytes(sample.bytes),
                bytes: Number(sample.bytes) || 0,
                reasonText: "Untouched for " + sample.ageDays + " days",
                actionText: "Covered by the plan",
                selectable: false,
                selected: false,
                tone: "removable",
                baseline: null,
                kind: "temp",
                safety: "Recent and in-use files are excluded by the scanner.",
                evidence: "Older than " + report.olderThanDays + " days",
                note: "Samples only; the plan covers every candidate.",
                skipReason: "",
            })),
        );
        this.planTempFiles = report.candidateFiles || 0;
        this.planTempBytes = report.candidateBytes || 0;
        this.domainMeta =
            formatCount(report.candidateFiles, "candidate") + " · " + formatBytes(report.candidateBytes);
        this.statusBarText =
            "Temp plan ready · " + formatCount(report.candidateFiles, "candidate") +
            " · " + formatBytes(report.candidateBytes);
        this.emptyTitle = "No temp candidates";
        this.emptyText = "Nothing under this root is older than the cutoff.";
    }

    applyBuildRootPlan(report) {
        this.settleNote();
        this.buildConfig = report.configPath || "";
        const entries = report.entries || [];
        this.acceptCandidates(
            entries.map((entry) => ({
                id: String(entry.path || ""),
                name: baseName(entry.path),
                path: String(entry.path || ""),
                sizeText: formatBytes(entry.bytes),
                bytes: Number(entry.bytes) || 0,
                reasonText: "Line " + entry.line + " · " + String(entry.authorization || ""),
                actionText: entry.removable ? "Delete directory" : "Keep",
                selectable: !!entry.removable,
                selected: false,
                tone: entry.removable ? "removable" : "skipped",
                baseline: null,
                kind: "build-root",
                safety: "Declared by the operator in the build-root config.",
                evidence: String(report.configPath || ""),
                note: "",
                skipReason: String(entry.skipReason || ""),
            })),
        );
        this.domainMeta =
            formatCount(entries.length, "entry") + " · " + formatBytes(report.totalBytes);
        this.statusBarText = report.configExists
            ? "Build roots ready · " + formatCount(entries.length, "entry")
            : "No build-root config found";
        this.emptyTitle = report.configExists ? "No build roots declared" : "No build-root config";
        this.emptyText = report.configExists
            ? "The config declares no build roots for this scope."
            : "Create the build-root config or point Scope at one, then scan again.";
    }

    applyRegistry(report) {
        this.settleNote();
        const findings = report.findings || [];
        this.acceptCandidates(
            findings.map((finding, index) => ({
                id: "reg-" + index,
                name: String(finding.displayName || finding.valueName || finding.kind),
                path: String(finding.keyPath || ""),
                sizeText: "—",
                bytes: 0,
                reasonText: String(finding.evidence || ""),
                actionText: "Review only",
                selectable: false,
                selected: false,
                tone: "review",
                baseline: null,
                kind: String(finding.kind || "registry"),
                safety: String(finding.safety || ""),
                evidence: String(finding.target || ""),
                note: "Registry cleaning is not wired into this workbench yet.",
                skipReason: "",
            })),
        );
        this.domainMeta = formatCount(findings.length, "finding") + " · " + report.scannedKeys + " keys scanned";
        this.statusBarText = "Registry residue ready · " + formatCount(findings.length, "finding");
        this.emptyTitle = "No registry residue";
        this.emptyText = "No orphaned keys matched in this scan.";
    }

    applyEnvPath(report) {
        this.settleNote();
        const scopes = report.scopes || [];
        const rows = [];
        let index = 0;
        for (const scope of scopes) {
            for (const entry of scope.entries || []) {
                index += 1;
                rows.push({
                    id: "env-" + index,
                    name: String(entry.raw || ""),
                    path: String(entry.expanded || entry.raw || ""),
                    sizeText: "—",
                    bytes: 0,
                    reasonText: String(entry.issue || "no issue") + " · " + String(entry.scope || ""),
                    actionText: entry.removable ? "Review only" : "Keep",
                    selectable: false,
                    selected: false,
                    tone: entry.issue ? "review" : "skipped",
                    baseline: null,
                    kind: "path-entry",
                    safety: String(entry.safety || ""),
                    evidence: String(entry.evidence || ""),
                    note: "PATH cleaning needs a backup target and is not wired into this workbench yet.",
                    skipReason: "",
                });
            }
        }
        this.acceptCandidates(rows);
        this.domainMeta = formatCount(rows.length, "entry") + " in " + formatCount(scopes.length, "scope");
        this.statusBarText = "PATH scan ready · " + formatCount(rows.length, "entry");
        this.emptyTitle = "No PATH entries";
        this.emptyText = "Neither user nor machine PATH returned entries.";
    }

    applySoftware(report) {
        this.settleNote();
        const findings = report.findings || [];
        this.acceptCandidates(
            findings.map((finding) => ({
                id: String(finding.id || finding.path || ""),
                name: String(finding.displayName || baseName(finding.path)),
                path: String(finding.path || ""),
                sizeText: formatBytes(finding.bytes),
                bytes: Number(finding.bytes) || 0,
                reasonText: String(finding.rule || "") + " · " + String(finding.evidence || ""),
                actionText: finding.removable ? "Review only" : "Keep",
                selectable: false,
                selected: false,
                tone: "review",
                baseline: null,
                kind: String(finding.kind || "software"),
                safety: String(finding.safety || ""),
                evidence: String(finding.registryKey || ""),
                note: "Software residue cleanup has no host command yet; review only.",
                skipReason: "",
            })),
        );
        this.domainMeta =
            formatCount(findings.length, "finding") + " · " + formatCount(report.skipped.length, "skipped install");
        this.statusBarText = "Software residue ready · " + formatCount(findings.length, "finding");
        this.emptyTitle = "No software residue";
        this.emptyText = formatCount(report.skipped.length, "install") + " were checked and kept.";
    }

    applyDevClean(report) {
        this.settleNote();
        this.planOpen = false;
        this.resultsOpen = true;
        this.resultTitle = "Deletion finished";
        this.resultMeta =
            report.executed
                ? "Freed " + formatBytes(report.freedBytes) + " · " + this.mode + " mode"
                : "Host reported no execution";
        this.resultRows = (report.items || []).map((item, index) => ({
            id: "res-" + index,
            key: String(item.path || ""),
            value: String(item.status || "") + (item.reason ? " · " + item.reason : "") + " · " + formatBytes(item.bytes),
            tone: item.status === "deleted" || item.status === "trashed" ? "removable" : "skipped",
        }));
        this.statusBarText =
            "Execution finished · " + formatBytes(report.freedBytes) + " freed";
        this.clearSelection();
    }

    applyTempClean(report) {
        this.settleNote();
        this.planOpen = false;
        this.resultsOpen = true;
        this.resultTitle = "Temp cleanup finished";
        this.resultMeta =
            "Deleted " + formatCount(report.deletedFiles, "file") + " · " + formatBytes(report.freedBytes) + " freed";
        this.resultRows = (report.items || []).map((item, index) => ({
            id: "tmp-" + index,
            key: String(item.path || ""),
            value: String(item.status || "") + (item.reason ? " · " + item.reason : "") + " · " + formatBytes(item.bytes),
            tone: item.status === "deleted" ? "removable" : "skipped",
        }));
        this.statusBarText = "Temp cleanup finished · " + formatBytes(report.freedBytes) + " freed";
        this.clearSelection();
    }

    applyBuildRootClean(report) {
        this.settleNote();
        this.planOpen = false;
        this.resultsOpen = true;
        this.resultTitle = "Build roots removed";
        this.resultMeta =
            formatCount(report.deletedDirs, "directory") + " · " + formatBytes(report.freedBytes) + " freed";
        this.resultRows = (report.items || []).map((item, index) => ({
            id: "br-" + index,
            key: String(item.path || ""),
            value: String(item.status || "") + " · " + formatBytes(item.bytes) + " · " + formatCount(item.files, "file"),
            tone: String(item.status || "").indexOf("deleted") === 0 ? "removable" : "skipped",
        }));
        this.statusBarText = "Build roots removed · " + formatBytes(report.freedBytes) + " freed";
        this.clearSelection();
    }

    acceptCandidates(rows) {
        this.raw = rows;
        this.statusText = "";
        this.refreshRows();
        this.recalcSelection();
        const first = this.rows.length ? this.rows[0] : null;
        if (first) this.activateRow(first.id);
        else this.clearFocused();
    }

    refreshRows() {
        const needle = String(this.filter || "").trim().toLowerCase();
        let rows = this.raw.filter((row) => {
            if (!needle) return true;
            return (String(row.path || "") + " " + String(row.name || "")).toLowerCase().indexOf(needle) >= 0;
        });
        const dir = this.sortDir === "asc" ? 1 : -1;
        const key = this.sortKey;
        rows.sort((left, right) => {
            if (key === "name") {
                return left.name.localeCompare(right.name) * dir;
            }
            return (left.bytes - right.bytes) * dir;
        });
        this.rows = rows;
        if (this.rows.length && !this.focusedPath) this.activateRow(this.rows[0].id);
    }

    sortBy(key) {
        if (this.sortKey === key) {
            this.sortDir = this.sortDir === "desc" ? "asc" : "desc";
        } else {
            this.sortKey = key;
            this.sortDir = "desc";
        }
        this.refreshRows();
    }

    activateRow(id) {
        const row = this.findRow(id);
        if (!row) return;
        this.focusedId = id;
        this.focusedPath = row.path;
        this.focusedKind = row.kind;
        this.focusedSize = row.sizeText;
        this.focusedShare = "—";
        this.focusedReason = row.reasonText;
        this.focusedAction = row.actionText;
        this.focusedSafety = row.safety;
        this.focusedEvidence = row.evidence;
        this.focusedNote = row.skipReason
            ? "Skip reason: " + row.skipReason
            : row.note || "";
    }

    findRow(id) {
        for (const row of this.raw) {
            if (row.id === id) return row;
        }
        return null;
    }

    toggleRow(id) {
        const row = this.findRow(id);
        if (!row || !row.selectable) return;
        row.selected = !row.selected;
        if (this.planOpen) this.closePlan();
        this.refreshRows();
        this.recalcSelection();
        this.activateRow(id);
    }

    clearFocused() {
        this.focusedId = "";
        this.focusedPath = "";
        this.focusedKind = "";
        this.focusedSize = "";
        this.focusedShare = "";
        this.focusedReason = "";
        this.focusedAction = "";
        this.focusedSafety = "";
        this.focusedEvidence = "";
        this.focusedNote = "";
    }

    clearSelection() {
        for (const row of this.raw) row.selected = false;
        this.refreshRows();
        this.recalcSelection();
    }

    recalcSelection() {
        let count = 0;
        let bytes = 0;
        for (const row of this.raw) {
            if (row.selected) {
                count += 1;
                bytes += row.bytes;
            }
        }
        this.selectedCount = count;
        this.selectedBytes = bytes;

        if (this.domain === "temp") {
            this.selectionCountText = formatCount(this.planTempFiles || 0, "candidate");
            this.selectionBytesText = formatBytes(this.planTempBytes || 0);
            this.selectionModeText = "Older than " + this.tempOlderThanDays + " days · whole plan";
        } else if (this.domain === "disk") {
            this.selectionCountText = "Read-only board";
            this.selectionBytesText = formatBytes(this.boardTotal);
            this.selectionModeText = "The disk scan deletes nothing";
        } else if (this.domain === "registry" || this.domain === "envPath" || this.domain === "software") {
            this.selectionCountText = formatCount(this.raw.length, "finding");
            this.selectionBytesText = "";
            this.selectionModeText = "Review only — no execution path in this workbench yet";
        } else {
            this.selectionCountText = count === 0 ? "No selection" : formatCount(count, "item");
            this.selectionBytesText = count === 0 ? "" : formatBytes(bytes);
            this.selectionModeText =
                (this.domain === "dev" ? (this.mode === "trash" ? "Recycle bin" : "Permanent delete") : "Delete directories");
        }

        const executable = this.domain === "dev" || this.domain === "buildRoots";
        const planCapable = executable || this.domain === "temp";
        this.reviewDisabled = this.busy || !planCapable || (executable && count === 0);
        this.executeDisabled = this.busy || !this.planOpen || (executable && count === 0);
        this.clearDisabled = this.busy || count === 0;
        this.executeLabel = this.domain === "dev" ? (this.mode === "trash" ? "Delete to recycle bin" : "Delete permanently") : "Delete";
    }

    openPlan() {
        if (this.reviewDisabled) return;
        this.resultsOpen = false;
        this.planOpen = true;
        this.planWarning = "";
        this.recalcSelection();
        if (this.domain === "dev") {
            this.planTitle = "Plan: " + formatCount(this.selectedCount, "artifact");
            this.planMeta =
                formatBytes(this.selectedBytes) + " · " +
                (this.mode === "trash" ? "recycle bin" : "permanent deletion") + " · revalidated at deletion";
            this.planRows = this.selectedRows().map((row, index) => ({
                id: "plan-" + index,
                key: row.path,
                value: row.sizeText + " · " + row.reasonText,
                tone: row.tone,
            }));
            return;
        }
        if (this.domain === "buildRoots") {
            this.planTitle = "Plan: " + formatCount(this.selectedCount, "directory");
            this.planMeta = formatBytes(this.selectedBytes) + " · declared build roots";
            this.planRows = this.selectedRows().map((row, index) => ({
                id: "plan-" + index,
                key: row.path,
                value: row.sizeText + " · " + row.reasonText,
                tone: row.tone,
            }));
            return;
        }
        this.planTitle = "Plan: " + formatCount(this.planTempFiles || 0, "candidate");
        this.planMeta =
            formatBytes(this.planTempBytes || 0) + " · older than " + this.tempOlderThanDays + " days · " + this.tempRoot;
        this.planRows = this.raw.map((row, index) => ({
            id: "plan-" + index,
            key: row.path,
            value: row.sizeText + " · " + row.reasonText,
            tone: row.tone,
        }));
        this.planWarning = "The plan covers every candidate; per-file selection is not offered for temp scans.";
    }

    selectedRows() {
        return this.raw.filter((row) => row.selected);
    }

    closePlan() {
        this.planOpen = false;
        this.recalcSelection();
    }

    closeResults() {
        this.resultsOpen = false;
    }

    execute() {
        if (this.executeDisabled) return;
        this.busy = true;
        this.statusText = "Deleting…";
        this.statusBarText = "Deleting…";
        this.planOpen = false;
        this.recalcSelection();
        if (this.domain === "dev") {
            this.post("devClean", {
                options: {
                    targets: this.selectedRows().map((row) => ({ path: row.path, baseline: row.baseline })),
                    mode: this.mode,
                    confirm: true,
                },
            });
            return;
        }
        if (this.domain === "buildRoots") {
            this.post("buildRootClean", {
                options: {
                    config: this.buildConfig || null,
                    paths: this.selectedRows().map((row) => row.path),
                    confirm: true,
                },
            });
            return;
        }
        this.post("tempClean", {
            options: {
                root: this.tempRoot || null,
                olderThanDays: this.tempOlderThanDays,
                cutoffUnixMs: this.tempCutoffMs,
                confirm: true,
            },
        });
    }
}
</script>
