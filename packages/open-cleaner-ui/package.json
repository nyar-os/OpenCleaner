{
    "name": "@wae/open-cleaner-ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Open Cleaner WebView UI built with @vmz/ui",
    "scripts": {
        "design:init": "vmz init design --preset web-surface",
        "check": "vmz check .",
        "build": "vmz build . --profile static",
        "serve": "vmz serve . --profile static",
        "stage": "node --experimental-strip-types ./scripts/stage-gui.ts"
    },
    "dependencies": {
        "@vmz/core": "0.3.13",
        "@vmz/ui": "0.3.13",
        "@vmz/ui-icons": "0.3.13"
    },
    "devDependencies": {
        "@vmz/vmz": "0.3.13"
    },
    "license": "MIT",
    "repository": "https://github.com/nyar-os/OpenCleaner"
}
